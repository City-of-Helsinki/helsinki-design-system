{
  "name": "hds-react",
  "version": "6.0.5",
  "description": "React components for the Helsinki Design System",
  "homepage": "https://github.com/City-of-Helsinki/helsinki-design-system#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/City-of-Helsinki/helsinki-design-system.git"
  },
  "license": "MIT",
  "engines": {
    "node": "^24"
  },
  "main": "./lib/cjs/index.js",
  "module": "./lib/index.js",
  "esnext": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/cjs/index.js"
    },
    "./components": {
      "types": "./lib/components/index.d.ts",
      "import": "./lib/components/index.js"
    },
    "./components/index": {
      "types": "./lib/components/index.d.ts",
      "import": "./lib/components/index.js"
    },
    "./components/*": {
      "types": "./lib/components/*/index.d.ts",
      "import": "./lib/components/*/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "sideEffects": [
    "base.module*"
  ],
  "scripts": {
    "build": "rimraf lib/ && pnpm run lint && pnpm run tcm && rollup -c && pnpm tsc --emitDeclarationOnly --skipLibCheck --project tsconfig.json",
    "build:hds-js": "rimraf ../hds-js/lib/ && pnpm lint:code && pnpm run tcm && rollup -c --environment hdsJS",
    "build:hds-js-standalone": "rimraf ../hds-js/lib/standalone && rollup -c --environment standalone",
    "update:hds-js": "rollup -c --environment hdsJSUpdate",
    "clean": "rimraf node_modules lib storybook-static ../hds-js/lib/",
    "start": "tcm src internal --watch & pnpm storybook",
    "nolint": "ESLINT_NO_DEV_ERRORS=true pnpm start",
    "scaffold": "node scripts/scaffold.js",
    "icon": "node scripts/icon.js",
    "tsc:es5": "tsc",
    "tsc:es6": "tsc -m es6 --outDir lib-esm --moduleResolution node",
    "tcm": "tcm src",
    "ts-check": "tcm src internal && pnpm tsc --skipLibCheck --noEmit --project tsconfig.json",
    "ts-check-storybook": "pnpm tsc --project ./.storybook/storybook-tsconfig.json",
    "lint": "pnpm lint:code && pnpm lint:styles",
    "lint:code": "pnpm ts-check && pnpm eslint \"src/**/*.{ts,tsx}\"",
    "lint:styles": "pnpm stylelint \"src/**/*.{css,scss}\" --formatter verbose",
    "storybook": "pnpm ts-check-storybook && storybook dev -p 6006 --quiet",
    "build-storybook": "pnpm ts-check-storybook && NODE_OPTIONS='--disable-warning=DEP0040' storybook build --loglevel error",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "cp -r ./lib/. ."
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@rollup/plugin-babel": "5.3.1",
    "@rollup/plugin-commonjs": "15.1.0",
    "@rollup/plugin-json": "4.1.0",
    "@rollup/plugin-node-resolve": "9.0.0",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-actions": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-webpack5-compiler-swc": "^1.0.6",
    "@storybook/blocks": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-webpack5": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/glob": "^8.1.0",
    "@types/jest": "^29.5.14",
    "@types/jest-axe": "^3.5.9",
    "@types/lodash": "4.17.24",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/rollup-plugin-generate-package-json": "^3.2.9",
    "@types/uuid": "^9.0.8",
    "@types/yup": "^0.32.0",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-require-context-hook": "1.0.0",
    "chalk": "4.1.2",
    "css-loader": "5.2.7",
    "cssnano": "^5.1.15",
    "eslint": "8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "fake-indexeddb": "^6.2.5",
    "identity-obj-proxy": "3.0.0",
    "inquirer": "7.3.3",
    "jest": "^29.7.0",
    "jest-axe": "^5.0.1",
    "jest-environment-jsdom": "^29.7.0",
    "jest-fetch-mock": "^3.2.0",
    "postcss-import": "^12.0.1",
    "postcss-scss": "^4.0.9",
    "prettier": "3.9.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rimraf": "^6.1.3",
    "rollup": "2.80.0",
    "rollup-plugin-css-text": "^1.0.3",
    "rollup-plugin-delete": "^2.2.0",
    "rollup-plugin-generate-package-json": "^3.2.0",
    "rollup-plugin-includepaths": "0.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-terser": "7.0.2",
    "rollup-plugin-typescript2": "^0.37.0",
    "sass": "^1.101.0",
    "sass-loader": "^16.0.8",
    "storybook": "^8.6.18",
    "style-loader": "2.0.0",
    "stylelint": "^15.11.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard-scss": "^7.0.1",
    "stylelint-order": "^6.0.4",
    "ts-jest": "^29.4.11",
    "type-fest": "^4.41.0",
    "typed-css-modules": "0.9.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "@babel/runtime": "^7.29.7",
    "@hookform/resolvers": "^2.9.11",
    "@juggle/resize-observer": "3.4.0",
    "@popperjs/core": "2.11.8",
    "@react-aria/visually-hidden": "3.9.1",
    "@react-spring/web": "9.7.5",
    "@types/cookie": "^0.6.0",
    "await-to-js": "^3.0.0",
    "cookie": "^0.7.2",
    "crc-32": "1.2.2",
    "date-fns": "2.30.0",
    "graphql": "^16.14.2",
    "hds-core": "6.0.5",
    "hds-design-tokens": "6.0.5",
    "jwt-decode": "^3.1.2",
    "kashe": "1.2.0",
    "lodash": "^4.18.1",
    "oidc-client-ts": "^2.5.0",
    "postcss": "8.5.23",
    "postcss-nesting": "^10.2.0",
    "react-hook-form": "^7.81.0",
    "react-merge-refs": "1.1.0",
    "react-popper": "2.3.0",
    "react-use-measure": "2.1.7",
    "uuid": "^14.0.1",
    "yup": "^1.7.1"
  },
  "peerDependencies": {
    "postcss": "^8.4.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
